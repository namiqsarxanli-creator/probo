# Copy this file to .env and fill locally. Never commit or share your key.
# Provider must support Chat Completions and JSON object mode.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# GROQ_API_KEY is also accepted when AI_API_KEY is empty.
GROQ_API_KEY=
AI_MODEL=
# Enter CURRENT provider prices for the chosen model. No default price assumed.
# USD per 1 million tokens, e.g. use 0 only if your actual tariff is free.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Optional: Telegram bot for the Söz Agentliyi demo. Create one with @BotFather.
TELEGRAM_BOT_TOKEN=
